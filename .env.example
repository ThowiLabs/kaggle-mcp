# Kaggle MCP — servidor Model Context Protocol para Kaggle
# No guardes PIN ni tokens reales en archivos versionados.
MCP_ENABLED=true
MCP_TUNNEL=auto
MCP_GRADIO_RETRIES=3
MCP_LISTEN_PORT=8181
