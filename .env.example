# KagMCP: mismas etiquetas como variables y Kaggle Secrets.
# No publiques tokens, PIN ni contraseñas en Git. Estas líneas sensibles deben
# existir únicamente en Kaggle Secrets o en un entorno privado no versionado.
MCP_ENABLED=true
MCP_TUNNEL=cloudflare
MCP_LISTEN_PORT=8181
SSH_ENABLED=false
# MCP_ACCESS_PIN=PIN_ALEATORIO_DE_AL_MENOS_12_CARACTERES
# GITHUB_TOKEN=PERSONAL_ACCESS_TOKEN_FINE_GRAINED
# HF_TOKEN=TOKEN_HUGGING_FACE
# Alternativa: introducirlos en el panel autenticado; no se guardan en disco.
# Para HTTPS con proxy propio (en vez de Quick Tunnel):
# MCP_TUNNEL=none
# MCP_PUBLIC_URL=https://mcp.example.net

# SSH es opcional. Actívalo y configura el VPS solo si lo necesitas.
# SSH_ENABLED=true
# SSH_HOST=IP_PUBLICA_DEL_VPS
# SSH_USER=root
# SSH_PASSWORD=SECRETO_VPS
# SSH_KEY=/ruta/clave-privada
# SSH_LOGIN_PASSWORD=SECRETO_DIFERENTE
# SSH_AUTHORIZED_KEYS=/ruta/authorized_keys
# SSH_PORT_REMOTE=22
# SSH_PORT_KAGGLE=2223
# SSH_PORT_LOCAL=2224
# SSH_FINGERPRINT=SHA256:HUELLA_CONFIABLE_VPS
# SSH_KNOWN_HOSTS=/kaggle/working/.kagmcp/ssh/known_hosts
# SSH_HOST_KEY=/kaggle/working/.kagmcp/ssh/host_ed25519
